# Neon Auth Configuration (Managed Better Auth)
# Obtain your Auth URL from Neon Console -> Project -> Auth -> Configuration
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.us-east-1.aws.neon.tech/neondb/auth

# 32+ character secret for session cookie encryption (generate with: openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=replace_with_a_secure_32_character_secret_key_minimum

# Public Auth base URL for client-side authentication requests (set to the same value as NEON_AUTH_BASE_URL)
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Neon Database Connection (Pooled for runtime, unpooled for migrations)
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Real-Debrid OAuth2 Configuration (Obtain from https://real-debrid.com/api)
REAL_DEBRID_CLIENT_ID=your_real_debrid_client_id
REAL_DEBRID_CLIENT_SECRET=your_real_debrid_client_secret
REAL_DEBRID_REDIRECT_URI=http://localhost:3000/api/integrations/real-debrid/callback

# Provider Token Encryption Key (32-byte / 256-bit key: generate with openssl rand -hex 32)
PROVIDER_TOKEN_ENCRYPTION_KEY=replace_with_a_64_character_hex_encryption_key
